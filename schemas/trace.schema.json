{
  "code_span": {
    "additionalProperties": false,
    "description": "A 1-indexed, inclusive line range in a repository file (repo-relative path).",
    "properties": {
      "end_line": {
        "minimum": 1,
        "title": "End Line",
        "type": "integer"
      },
      "path": {
        "title": "Path",
        "type": "string"
      },
      "start_line": {
        "minimum": 1,
        "title": "Start Line",
        "type": "integer"
      }
    },
    "required": [
      "path",
      "start_line",
      "end_line"
    ],
    "title": "CodeSpan",
    "type": "object"
  },
  "run_manifest": {
    "additionalProperties": false,
    "description": "Everything needed to identify and reproduce a run.",
    "properties": {
      "agent_config": {
        "title": "Agent Config",
        "type": "string"
      },
      "base_commit": {
        "title": "Base Commit",
        "type": "string"
      },
      "budget": {
        "additionalProperties": true,
        "title": "Budget",
        "type": "object"
      },
      "codetrace_git_commit": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Codetrace Git Commit"
      },
      "dataset_name": {
        "title": "Dataset Name",
        "type": "string"
      },
      "dataset_revision": {
        "title": "Dataset Revision",
        "type": "string"
      },
      "environment": {
        "additionalProperties": true,
        "title": "Environment",
        "type": "object"
      },
      "experiment_id": {
        "title": "Experiment Id",
        "type": "string"
      },
      "model_name": {
        "title": "Model Name",
        "type": "string"
      },
      "model_params": {
        "additionalProperties": true,
        "title": "Model Params",
        "type": "object"
      },
      "model_provider": {
        "title": "Model Provider",
        "type": "string"
      },
      "repo": {
        "title": "Repo",
        "type": "string"
      },
      "run_id": {
        "title": "Run Id",
        "type": "string"
      },
      "schema_version": {
        "default": "0.1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "seed": {
        "title": "Seed",
        "type": "integer"
      },
      "started_at": {
        "title": "Started At",
        "type": "string"
      },
      "system_prompt": {
        "title": "System Prompt",
        "type": "string"
      },
      "system_prompt_sha256": {
        "title": "System Prompt Sha256",
        "type": "string"
      },
      "task_instance_id": {
        "title": "Task Instance Id",
        "type": "string"
      },
      "tool_names": {
        "items": {
          "type": "string"
        },
        "title": "Tool Names",
        "type": "array"
      }
    },
    "required": [
      "run_id",
      "experiment_id",
      "agent_config",
      "seed",
      "task_instance_id",
      "dataset_name",
      "dataset_revision",
      "repo",
      "base_commit",
      "model_provider",
      "model_name",
      "model_params",
      "system_prompt_sha256",
      "system_prompt",
      "tool_names",
      "budget",
      "environment",
      "codetrace_git_commit",
      "started_at"
    ],
    "title": "RunManifest",
    "type": "object"
  },
  "token_usage": {
    "additionalProperties": false,
    "properties": {
      "cache_creation_input_tokens": {
        "default": 0,
        "title": "Cache Creation Input Tokens",
        "type": "integer"
      },
      "cache_read_input_tokens": {
        "default": 0,
        "title": "Cache Read Input Tokens",
        "type": "integer"
      },
      "input_tokens": {
        "default": 0,
        "title": "Input Tokens",
        "type": "integer"
      },
      "method": {
        "default": "provider",
        "title": "Method",
        "type": "string"
      },
      "output_tokens": {
        "default": 0,
        "title": "Output Tokens",
        "type": "integer"
      }
    },
    "title": "TokenUsage",
    "type": "object"
  },
  "trace_event": {
    "$defs": {
      "EventKind": {
        "enum": [
          "run_start",
          "model_request",
          "model_response",
          "tool_call",
          "tool_result",
          "code_location_viewed",
          "context_snapshot",
          "context_compaction",
          "retrieval",
          "patch_generated",
          "budget_exhausted",
          "error",
          "run_end"
        ],
        "title": "EventKind",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "kind": {
        "$ref": "#/$defs/EventKind"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      },
      "run_id": {
        "title": "Run Id",
        "type": "string"
      },
      "schema_version": {
        "default": "0.1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "seq": {
        "minimum": 0,
        "title": "Seq",
        "type": "integer"
      },
      "step": {
        "minimum": 0,
        "title": "Step",
        "type": "integer"
      },
      "timestamp": {
        "title": "Timestamp",
        "type": "string"
      }
    },
    "required": [
      "run_id",
      "seq",
      "step",
      "kind"
    ],
    "title": "TraceEvent",
    "type": "object"
  }
}
